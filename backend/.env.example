BIND_ADDRESS=127.0.0.1:8080
DATABASE_URL=sqlite://../backend/store.db?mode=rwc
STATIC_DIR=../modele-boutique
PRODUCT_UPLOAD_DIR=../assets/products
COOKIE_SECURE=true
# Set TRUST_PROXY=true only when a reverse proxy you control sets X-Real-IP or X-Forwarded-For.
TRUST_PROXY=false
ADMIN_EMAIL=admin@example.com
# Generate with: printf '%s\n' 'your-long-password' | ./target/release/aura-store-backend hash-password
# Keep the value in single quotes so the $ characters are not expanded.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace-with-generated-hash'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-domain.example/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=https://your-domain.example/auth/facebook/callback
