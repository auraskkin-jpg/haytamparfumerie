.hpf-badge svg { width: 20px; height: 20px; }


/* ================= BOTTOM BAR ================= */

.hpf-bottom {
  position: relative;
  z-index: 1;
  border-top: 1px solid var(--hpf-line);
  padding: 2.2rem 0 2.5rem;
  display: flex;
  flex-wrap: wrap;
