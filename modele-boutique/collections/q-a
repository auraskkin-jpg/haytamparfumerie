      color:#111; text-align:left;
      position:relative;
    }
    .bd-col h4::after{
      content:""; display:block; width:28px; height:3px; border-radius:3px;
      background:linear-gradient(90deg, var(--accent-1), var(--accent-2));
      margin-top:6px;
    }

    /* Links: compact */
    .bd-col ul{ list-style:none; margin:0; padding:0; }
    .bd-col li a,
    .bd-menu a{
