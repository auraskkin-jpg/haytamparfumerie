/* Hide the "Chat with us" text label */
  #nettjer { display: none !important; }

  /* The button itself: no background, just the icon, bigger */
  .blantershow-chat {
    width: 70px !important;
    height: 70px !important;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    animation: pushdaddy-bounce 1.8s ease-in-out infinite;
  }

  .blantershow-chat:hover {
    animation-play-state: paused;
    transform: scale(1.08);
  }

  /* Bigger WhatsApp icon, with its own drop shadow so it stays visible on any background */
  .blantershow-chat .svg-whatsapp {
    width: 62px !important;
    height: 62px !important;
    filter: drop-shadow(0 6px 14px rgba(0,0,0,.25));
  }

  /* Bounce to draw attention */
  @keyframes pushdaddy-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }

  @media (max-width: 480px) {
    .blantershow-chat {
      width: 60px !important;
      height: 60px !important;
    }
    .blantershow-chat .svg-whatsapp {
      width: 52px !important;
      height: 52px !important;
    }
  }
