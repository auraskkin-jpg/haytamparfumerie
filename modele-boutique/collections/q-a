  }
  .hpf-logo { justify-content: center; }
  .hpf-desc { margin-left: auto; margin-right: auto; }

  .hpf-col--links,
  .hpf-col--delivery { position: relative; }

  .hpf-col--links::after {
    content: "";
    position: absolute;
    top: .2rem; bottom: .2rem; right: -.9rem;
    width: 1px;
    background: var(--hpf-line);
  }

  .hpf-col--contact {
    grid-column: 1 / -1;
    background: #fff;
    border-radius: 20px;
    padding: 1.6rem 1.5rem;
    box-shadow: 0 10px 30px rgba(46,38,33,.06);
  }

  .hpf-heading { font-size: 1.2rem; margin-bottom: 1.2rem; }
  .hpf-links a, .hpf-payment li, .hpf-contact li { font-size: 1.05rem; }
  .hpf-eyebrow { font-size: .95rem; }

  .hpf-bottom { flex-direction: column; align-items: center; text-align: center; gap: 1.3rem; }
  .hpf-legal { justify-content: center; gap: 1rem 1.4rem; }

  .hpf-whatsapp { right: 1rem; bottom: 1rem; width: 60px; height: 60px; }
  .hpf-whatsapp svg { width: 30px; height: 30px; }
}

@media (max-width: 460px) {
  .hpf-grid { grid-template-columns: 1fr; }
  .hpf-col--links::after { display: none; }
  .hpf-col--links, .hpf-col--delivery { text-align: center; }
  .hpf-col--links .hpf-links, .hpf-col--delivery .hpf-payment { align-items: center; }
  .hpf-col--links a { width: auto; }
  .hpf-col--delivery .hpf-courier { margin-left: auto; margin-right: auto; }
