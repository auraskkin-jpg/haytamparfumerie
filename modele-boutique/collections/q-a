/* ================= WHATSAPP FLOAT ================= */

.hpf-whatsapp {
  position: fixed;
  right: 1.25rem;
  bottom: 1.25rem;
  z-index: 999;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--hpf-whatsapp);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 10px 22px rgba(37,211,102,.35);
}

.hpf-whatsapp svg { width: 28px; height: 28px; fill: #fff; position: relative; z-index: 1; }

.hpf-wa-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(37,211,102,.55);
  animation: hpfPulse 2.4s ease-out infinite;
}

@keyframes hpfPulse {
  0%   { box-shadow: 0 0 0 0 rgba(37,211,102,.55); }
  70%  { box-shadow: 0 0 0 16px rgba(37,211,102,0); }
  100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); }
}

@media (prefers-reduced-motion: reduce) {
  .hpf-wa-ring { animation: none; }
}


/* ================= RESPONSIVE ================= */

@media (max-width: 1080px) {
